# =========================
# SuCash project environment template
# Copy this file to `.env` and fill secrets locally.
# Never commit real secrets.
# =========================

# Server bind config
SUCASH_SERVER_HOST=0.0.0.0
SUCASH_SERVER_PORT=8080

# Local SQLite DB fallback (used when TURSO_DATABASE_URL is empty)
SUCASH_SERVER_DB_PATH=data/sucash-server.db

# Turso credentials (when set, server uses Turso/libSQL as primary DB)
TURSO_DATABASE_URL=libsql://your-db-name.region.turso.io
TURSO_AUTH_TOKEN=
SUCASH_MIGRATE_LOCAL_SQLITE_TO_TURSO=false
# Optional source path for one-time migration when flag above is true.
SUCASH_MIGRATION_SOURCE_DB_PATH=data/sucash-server.db

# Optional mobile defaults (manual app settings still apply)
SUCASH_DEFAULT_OUTLET_ID=default
SUCASH_DEFAULT_SERVER_BASE_URL=http://10.0.2.2:8080

# Legacy shared secret for protected write APIs (backward compatibility).
# New flow should use pairing + session token instead of deriving bearer on mobile.
SUCASH_API_SHARED_SECRET=
# Issued server auth-session token TTL (seconds). Default 86400 (24h).
SUCASH_API_SESSION_TTL_SECONDS=86400
# Pairing code TTL (seconds). Use 0 for one-time lifetime code (until redeemed).
# Positive value uses min 30 and max 1800.
SUCASH_API_PAIRING_TTL_SECONDS=0

# Security hardening:
# If true, legacy shared-secret bearer token is accepted.
# Keep false for production; pairing/session token should be used.
SUCASH_ALLOW_LEGACY_TOKEN_AUTH=false
# If true, local/private-network clients may create pairing code without prior auth.
# Keep true for first-time onboarding; set false on public production after bootstrap.
SUCASH_ALLOW_LOCAL_PAIRING_BOOTSTRAP=true
# If true, API requests must explicitly provide outlet_id/outlet query.
SUCASH_REQUIRE_EXPLICIT_OUTLET_ID=true

# Reservation anti-spam limiter (POST /api/reservations)
SUCASH_RESERVATION_RATE_LIMIT_ENABLED=true
SUCASH_RESERVATION_RATE_LIMIT_MAX_REQUESTS=5
SUCASH_RESERVATION_RATE_LIMIT_WINDOW_SECONDS=60
